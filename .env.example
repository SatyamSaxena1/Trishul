TRISHUL_HOSTNAME=trishul.example.internal
HTTPS_PORT=443
TRISHUL_IMAGE=registry.example.internal/ai-trishul@sha256:replace-with-64-character-release-digest
TRISHUL_EDGE_IMAGE=registry.example.internal/ai-trishul-edge@sha256:replace-with-64-character-release-digest
TRISHUL_CONTROLLER_IMAGE=registry.example.internal/ai-trishul-controller@sha256:replace-with-64-character-release-digest
TRISHUL_ANALYZER_IMAGE=ai-trishul-analyzer@sha256:replace-with-built-image-digest
ROOTLESS_OCI_SOCKET=/run/user/10002/docker.sock
WORKER_CONCURRENCY=2
ANALYSIS_CONCURRENCY=1
MIN_CPU_CORES=4
MIN_MEMORY_GIB=8
MIN_DISK_GIB=20
MIN_COMPOSE_VERSION=2.20.0
TLS_MIN_VALID_DAYS=30

OIDC_ISSUER=https://identity.example.internal
OIDC_BROWSER_ORIGIN=https://identity.example.internal
OIDC_AUDIENCE=ai-trishul
OIDC_JWKS_URL=https://identity.example.internal/.well-known/jwks.json
OIDC_DISCOVERY_URL=
OIDC_CA_BUNDLE=
OIDC_CLIENT_ID=ai-trishul-web
OIDC_MFA_REQUIRED=true
OIDC_MFA_ACR_VALUES=

S3_ENDPOINT_URL=https://objects.example.internal
S3_REGION=us-east-1
S3_BUCKET=trishul
S3_CA_BUNDLE=

AI_ENABLED=true
AI_ENDPOINT_URL=https://models.example.internal
AI_ENDPOINT_ALLOWLIST=models.example.internal
AI_CA_BUNDLE=
