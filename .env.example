TRISHUL_HOSTNAME=trishul.example.internal
HTTPS_PORT=443
TRISHUL_IMAGE=registry.example.internal/ai-trishul@sha256:replace-with-release-digest
TRISHUL_EDGE_IMAGE=registry.example.internal/ai-trishul-edge@sha256:replace-with-release-digest
TRISHUL_CONTROLLER_IMAGE=registry.example.internal/ai-trishul-controller@sha256:replace-with-release-digest
TRISHUL_ANALYZER_IMAGE=registry.example.internal/ai-trishul-analyzer@sha256:replace-with-release-digest

# Production release trust material. Relative paths are resolved from this directory.
RELEASE_MANIFEST=release-manifest.tsv
RELEASE_MANIFEST_SIGNATURE=release-manifest.tsv.sig
RELEASE_PUBLIC_KEY=release-public-key.pem
RELEASE_BUNDLE_DIR=.
ROOTLESS_OCI_SOCKET=/run/user/10002/docker.sock
WORKER_CONCURRENCY=2
ANALYSIS_CONCURRENCY=1

OIDC_ISSUER=https://identity.example.internal
OIDC_BROWSER_ORIGIN=https://identity.example.internal
OIDC_AUDIENCE=ai-trishul
OIDC_JWKS_URL=https://identity.example.internal/.well-known/jwks.json
OIDC_DISCOVERY_URL=
OIDC_CA_BUNDLE=
OIDC_CLIENT_ID=ai-trishul-web
OIDC_MFA_REQUIRED=true
OIDC_MFA_ACR_VALUES=

S3_ENDPOINT_URL=https://objects.example.internal
S3_REGION=us-east-1
S3_BUCKET=trishul
S3_CA_BUNDLE=

AI_ENDPOINT_ALLOWLIST=models.example.internal
